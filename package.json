{
  "name": "pokemon-go-in-web",
  "description": "Unofficial fan-made game — the web is your Pokémon safari, where a wild Gen-1 Pokémon wanders the bottom of each page you visit.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "build:pokemon-sprites-icon": "node scripts/download-icons.ts",
    "seed:species": "node scripts/fetch-species.ts"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "is-ip": "^5.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
